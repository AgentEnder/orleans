{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "installation": {
    "version": "23.2.1",
    "plugins": {
      "@nx/dotnet": "23.2.1"
    }
  },
  "plugins": [
    {
      "plugin": "@nx/dotnet",
      "exclude": [
        "samples/**",
        "docs/**",
        "templates/**"
      ],
      "options": {
        "test": {
          "options": {
            "args": [
              "--no-build",
              "--no-restore",
              "--framework",
              "net10.0",
              "--filter-query",
              "\"/[(Provider=None)&((Suite=BVT)|(Suite=SlowBVT)|(Suite=Functional))]\""
            ]
          }
        }
      }
    }
  ],
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.Tests/**/*",
      "!{projectRoot}/**/bin/**/*",
      "!{projectRoot}/**/obj/**/*"
    ]
  },
  "nxCloudUrl": "https://staging.nx.app",
  "nxCloudId": "6aa1d16cabcb6bfcf6298b42",
  "targetDefaults": {
    "test-redis": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": [
        "build",
        {
          "projects": "svc-redis",
          "target": "serve"
        }
      ],
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/.editorconfig",
        "{workspaceRoot}/ci/services/wait-for.sh",
        {
          "workingDirectory": "absolute"
        },
        {
          "dependentTasksOutputFiles": "**/*"
        }
      ],
      "outputs": [
        "{projectRoot}/TestResults"
      ],
      "options": {
        "cwd": "{projectRoot}",
        "parallel": false,
        "commands": [
          "\"$NX_WORKSPACE_ROOT\"/ci/services/wait-for.sh 127.0.0.1:6379",
          "dotnet test --no-build --no-restore --framework net10.0 --filter-query \"/[(Provider=Redis)&((Suite=BVT)|(Suite=SlowBVT)|(Suite=Functional))&(Category!=Performance)&(Category!=Stress)]\""
        ],
        "env": {
          "ORLEANSREDISCONNECTIONSTRING": "localhost:6379,ssl=False,abortConnect=False"
        }
      }
    },
    "test-postgres": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": [
        "build",
        {
          "projects": "svc-postgres",
          "target": "serve"
        }
      ],
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/.editorconfig",
        "{workspaceRoot}/ci/services/wait-for.sh",
        {
          "workingDirectory": "absolute"
        },
        {
          "dependentTasksOutputFiles": "**/*"
        }
      ],
      "outputs": [
        "{projectRoot}/TestResults"
      ],
      "options": {
        "cwd": "{projectRoot}",
        "parallel": false,
        "commands": [
          "\"$NX_WORKSPACE_ROOT\"/ci/services/wait-for.sh 127.0.0.1:5432",
          "dotnet test --no-build --no-restore --framework net10.0 --filter-query \"/[(Provider=PostgreSql)&((Suite=BVT)|(Suite=SlowBVT)|(Suite=Functional))&(Category!=Performance)&(Category!=Stress)]\""
        ],
        "env": {
          "ORLEANSPOSTGRESCONNECTIONSTRING": "Server=127.0.0.1;Port=5432;Pooling=false;User Id=postgres;Password=postgres;SSL Mode=Disable"
        }
      }
    },
    "test-sqlite": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": [
        "build"
      ],
      "inputs": [
        "default",
