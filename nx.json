        }
      ],
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/.editorconfig",
        "{workspaceRoot}/ci/services/wait-for.sh",
        {
          "workingDirectory": "absolute"
        },
        {
          "dependentTasksOutputFiles": "**/*"
        }
      ],
      "outputs": [
        "{projectRoot}/TestResults"
      ],
      "options": {
        "cwd": "{projectRoot}",
        "parallel": false,
        "commands": [
          "\"$NX_WORKSPACE_ROOT\"/ci/services/wait-for.sh 127.0.0.1:4222",
          "dotnet test --no-build --no-restore --framework net10.0 --filter-query \"/[(Provider=NATS)&((Suite=BVT)|(Suite=SlowBVT)|(Suite=Functional))&(Category!=Performance)&(Category!=Stress)]\""
        ]
      }
    }
  }
}
