      ],
      "options": {
        "cwd": "{projectRoot}",
        "parallel": false,
        "commands": [
          "dotnet test --no-build --no-restore --framework net10.0 --filter-query \"/[(Provider=Sqlite)&((Suite=BVT)|(Suite=SlowBVT)|(Suite=Functional))&(Category!=Performance)&(Category!=Stress)]\""
        ]
      }
    },
    "test-azurestorage": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": [
        "build",
        {
