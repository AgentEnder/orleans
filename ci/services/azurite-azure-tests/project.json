{
  "name": "svc-azurite-azure-tests",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "cache": false,
      "options": {
        "command": "npx --yes azurite@3 --silent --skipApiVersionCheck --location /tmp/orleans-svc-azurite-azure-tests --blobPort 10000 --queuePort 10001 --tablePort 10002"
      }
    }
  }
}
