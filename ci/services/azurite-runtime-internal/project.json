{
  "name": "svc-azurite-runtime-internal",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "cache": false,
      "options": {
        "command": "npx --yes azurite@3 --silent --skipApiVersionCheck --location /tmp/orleans-svc-azurite-runtime-internal --blobPort 10040 --queuePort 10041 --tablePort 10042"
