{
  "name": "svc-azurite-journaling",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "cache": false,
      "options": {
        "command": "npx --yes azurite@3 --silent --skipApiVersionCheck --location /tmp/orleans-svc-azurite-journaling --blobPort 10030 --queuePort 10031 --tablePort 10032"
      }
    }
  }
}
